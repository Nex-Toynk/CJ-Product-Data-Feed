# --- Shopify ---
# App in the Dev Dashboard: Settings -> Client credentials.
# The app and the store must be in the SAME Shopify organization, or the token
# request fails with shop_not_permitted.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. A pasted Admin API token from a legacy admin-created app; when set,
# it is used instead of the client credentials above. New apps cannot be created
# this way any more.
# SHOPIFY_ADMIN_TOKEN=

# Optional; defaults to 2026-07
SHOPIFY_API_VERSION=2026-07

# --- CJ SFTP ---
# Emailed to you when the feed is registered. Leave unset to force --dry-run.
CJ_SFTP_HOST=
CJ_SFTP_PORT=22
CJ_SFTP_USERNAME=
CJ_SFTP_PASSWORD=
# CJ only processes files left in the root directory.
CJ_SFTP_DIR=/
